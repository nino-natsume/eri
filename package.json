{
  "name": "eri-ai",
  "version": "1.1.5",
  "description": "绘里酱（羽贵绘里）跨平台人格部署包：Markdown 人格本体 + 一键脚本，零平台依赖，适配 Linux / macOS / Windows / Termux / WSL 及 AMD / ARM。基于 opencode-personality 提供 default / 绘里酱 / erotic 三人格与 mood 系统，含 5 个子智慧体（色情/代码/调试/架构/测试）、eri skill、AUR 打包三件套与 eri CLI，支持 OpenCode、Claude Code、Codex、Gemini、Qwen、Aider 等 18 种终端编程工具。",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-personality",
    "personality",
    "subagent",
    "skill",
    "mood",
    "ai",
    "llm",
    "agent",
    "cli",
    "eri",
    "claude-code",
    "codex",
    "gemini-cli",
    "qwen-code",
    "aider",
    "copilot",
    "astrbot",
    "cross-platform",
    "linux",
    "macos",
    "windows",
    "termux",
    "wsl",
    "arm",
    "tsundere",
    "archlinux",
    "aur"
  ],
  "homepage": "https://github.com/nino-natsume/eri",
  "bugs": {
    "url": "https://github.com/nino-natsume/eri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nino-natsume/eri.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "夏沐真凉",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "eri": "index.js"
  },
  "files": [
    "index.js",
    "ui/",
    "eri.md",
    "agents/",
    "SKILL.md",
    "personality.json",
    "opencode.json",
    "opencode-package.json",
    "opencode-package-lock.json",
    "erotic-chan.md",
    "code-monkey.md",
    "debug-san.md",
    "architect-sama.md",
    "test-chan.md",
    "install-eri.sh",
    "install-eri.ps1",
    "PKGBUILD",
    ".SRCINFO",
    "eri.install",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "version": "node sync-version.js",
    "deploy": "bash install-eri.sh",
    "deploy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File install-eri.ps1",
    "panel": "node ui/panel.js",
    "icon": "node ui/make-icon.js",
    "build:exe": "node ui/make-icon.js && node ui/native/gen-dll.js && bun build ./ui/panel.js ./ui/worker.js --compile --windows-icon=ui/icon.ico --windows-hide-console --outfile dist/eri-panel.exe",
    "build:exe:win": "node ui/make-icon.js && node ui/native/gen-dll.js && bun build ./ui/panel.js ./ui/worker.js --compile --target=bun-windows-x64 --windows-icon=ui/icon.ico --windows-hide-console --outfile dist/eri-panel.exe",
    "eri:help": "eri help",
    "eri:version": "eri version",
    "eri:update": "eri update",
    "eri:deep": "eri deep",
    "eri:ui": "eri ui",
    "eri:uninstall": "eri uninstall"
  },
  "engines": {
    "node": ">=18"
  }
}
